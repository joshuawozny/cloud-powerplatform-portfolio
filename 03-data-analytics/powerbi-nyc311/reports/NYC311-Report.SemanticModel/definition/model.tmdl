model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Dates

	annotation PBI_QueryGroupOrder = 0

queryGroup Dimensions

	annotation PBI_QueryGroupOrder = 1

queryGroup Facts

	annotation PBI_QueryGroupOrder = 2

queryGroup OLD

	annotation PBI_QueryGroupOrder = 3

queryGroup Aggregates

	annotation PBI_QueryGroupOrder = 4

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","DaxQueryView_Desktop"]

annotation PBI_QueryOrder = ["_Measures","Dim_Agency","Dim_Complaint","Dim_Date","Dim_Location","Dim_Status","RangeStart","RangeEnd","isDevMode","Fact_Service_Request_Old","Dim_Agency_Old","Dim_Complaint_Old","Dim_Date_Old","Diim_Location_Old","Dim_Status_Old","Last_Refresh_DateTime","Fact_Service_Request"]

ref table _Measures
ref table Last_Refresh_DateTime
ref table Dim_Agency
ref table Dim_Complaint
ref table Dim_Date
ref table Dim_Location
ref table Dim_Status
