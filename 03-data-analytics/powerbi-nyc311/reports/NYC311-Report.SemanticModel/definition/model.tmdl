model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Dates

	annotation PBI_QueryGroupOrder = 0

queryGroup Dimensions

	annotation PBI_QueryGroupOrder = 1

queryGroup Facts

	annotation PBI_QueryGroupOrder = 2

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["_Measures","RangeStart","RangeEnd","Dim_Agency","Dim_Complaint","Dim_Date","Diim_Location","Dim_Status","Fact_Service_Request","Last_Refresh_DateTime","isDevMode"]

ref table _Measures
ref table Dim_Agency
ref table Dim_Complaint
ref table Dim_Date
ref table Diim_Location
ref table Dim_Status
ref table Fact_Service_Request
ref table Last_Refresh_DateTime

ref cultureInfo en-US

